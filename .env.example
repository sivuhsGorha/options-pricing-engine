# Copy to .env and fill in. Never commit .env.
# Market data providers (leave unset to disable a source)
FINNHUB_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_KEY=
MARKETSTACK_KEY=

# Required: at least 32 characters
API_SECRET=
# Required: at least 12 characters
OPERATOR_PASSWORD=

# Set true only to paper-trade on SIMULATED data when no live feed is configured
ALLOW_SIMULATED_DATA=false

PORT=8080
# Use 0.0.0.0 only inside a container behind a trusted network
BIND_ADDRESS=127.0.0.1
# Comma-separated IPs of reverse proxies whose X-Forwarded-For is trusted for login rate limiting (empty = none)
TRUSTED_PROXIES=
# Set true when serving over TLS: marks session cookies Secure and sends HSTS
COOKIE_SECURE=false
# Seconds an incomplete HTTP request may stay open before the connection is closed
HTTP_REQUEST_TIMEOUT_SECONDS=30
ALLOWED_ORIGIN=http://127.0.0.1:8080,http://localhost:8080
MMAP_STATE_FILE=data/shm_state.dat
# Directory for the fill ledger and other state that must survive a restart (git-ignored)
DATA_DIR=data
